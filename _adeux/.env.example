# --- Mode réel (optionnel). Sans ces variables, l'app fonctionne en mode démo local. ---
# Clés PUBLIQUES uniquement (la clé "anon"/publishable). Jamais de service_role ici.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL WebSocket LiveKit (publique). Le jeton est généré côté serveur (Edge Function livekit-token).
VITE_LIVEKIT_URL=
# Facultatif : identifiant de build (injecté par le script de déploiement)
ADEUX_BUILD_ID=
# Facultatif : base si hébergé sous un sous-chemin (par défaut "/")
ADEUX_BASE=/
